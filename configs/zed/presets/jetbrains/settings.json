{
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sidebar_side": "left",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [
    "LXGW WenKai Mono"
  ],
  "ui_font_family": "Noto Sans",
  "ui_font_fallbacks": [
    "LXGW WenKai Mono"
  ],
  "terminal": {
    "dock": "bottom",
    "default_height": 300,
    "font_family": "JetBrains Mono",
    "font_fallbacks": [
      "LXGW WenKai Mono"
    ],
    "font_size": 17.0
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 18.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "VSCode Dark Modern"
  }
}
